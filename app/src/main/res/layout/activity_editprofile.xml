<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextView
        android:id="@+id/textView19"
        android:layout_width="347dp"
        android:layout_height="42dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/aldrich"
        android:text="@string/editprofile"
        android:textAlignment="center"
        android:textColor="@color/gold"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/frameLayout2"
        android:layout_width="372dp"
        android:layout_height="106dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="21dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="17dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/BulkLink">

        <ImageView
            android:id="@+id/imageView28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/navbar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHomeWork"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:padding="12dp"
                app:srcCompat="@drawable/exercisenon" />

            <ImageView
                android:id="@+id/navHomeNoti"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:padding="20dp"
                app:srcCompat="@drawable/notification" />

            <ImageView
                android:id="@+id/navHomeUser"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:padding="20dp"
                app:srcCompat="@drawable/userwhite" />
        </LinearLayout>

    </FrameLayout>

    <ImageView
        android:id="@+id/imageView24"
        android:layout_width="129dp"
        android:layout_height="113dp"
        android:layout_marginStart="141dp"
        android:layout_marginTop="68dp"
        android:layout_marginEnd="141dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView19"
        app:srcCompat="@drawable/userprofile" />

    <EditText
        android:id="@+id/editTextText"
        android:layout_width="293dp"
        android:layout_height="60dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="44dp"
        android:layout_marginEnd="59dp"
        android:ems="10"
        android:fontFamily="@font/aldrich"
        android:hint="Hishen Perera"
        android:inputType="text"
        android:textColor="@color/gold"
        android:textColorHint="#74FFA211"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView24" />

    <EditText
        android:id="@+id/editTextText4"
        android:layout_width="293dp"
        android:layout_height="60dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="59dp"
        android:ems="10"
        android:fontFamily="@font/aldrich"
        android:hint="hishenperera@gmail.com"
        android:inputType="text"
        android:textColor="@color/gold"
        android:textColorHint="#74FFA211"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextText" />

    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="293dp"
        android:layout_height="60dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="59dp"
        android:ems="10"
        android:fontFamily="@font/aldrich"
        android:hint="Beginner Level"
        android:inputType="text"
        android:textColor="@color/gold"
        android:textColorHint="#74FFA211"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextText4" />

    <EditText
        android:id="@+id/editTextText6"
        android:layout_width="293dp"
        android:layout_height="60dp"
        android:layout_marginStart="59dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="59dp"
        android:ems="10"
        android:fontFamily="@font/aldrich"
        android:hint="+94702667788"
        android:inputType="text"
        android:textColor="@color/gold"
        android:textColorHint="#74FFA211"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextText5" />

    <Button
        android:id="@+id/updateBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="104dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="105dp"
        android:backgroundTint="@color/gold"
        android:fontFamily="@font/aldrich"
        android:text="@string/updateprofile"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextText6" />

    <ImageView
        android:id="@+id/backeditBtn"
        android:layout_width="36dp"
        android:layout_height="34dp"
        android:layout_marginStart="31dp"
        android:layout_marginTop="38dp"
        android:layout_marginEnd="343dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back" />

</androidx.constraintlayout.widget.ConstraintLayout>